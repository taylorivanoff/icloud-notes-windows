{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iCloud Notes",
  "version": "2.0.5",
  "identifier": "io.github.taylorivanoff.icloud-notes",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "iCloud Notes",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "template": "./windows/installer.nsi",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyRjMzMEMzREEzQjJBMzIKUldReUtqdmF3ekR6d2taaHVETjd3MFA4SFpJMHRieG1WRG5sZHU5aWsrSkJXUFRJSTk4VlFoanIK",
      "endpoints": [
        "https://github.com/taylorivanoff/icloud-notes-windows/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
